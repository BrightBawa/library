 "doctype": "Print Format",
 "font_size": 12,
 "html": "<style>\n\t.lib-clear h3 { margin: 0 0 4px; }\n\t.lib-clear .meta td { padding: 2px 12px 2px 0; }\n\t.lib-clear .verdict { margin: 12px 0; padding: 8px 12px; border: 2px solid; font-size: 16px; font-weight: bold; }\n\t.lib-clear .ok { border-color: #2e7d32; color: #2e7d32; }\n\t.lib-clear .owe { border-color: #c62828; color: #c62828; }\n\t.lib-clear table.lines { width: 100%; border-collapse: collapse; }\n\t.lib-clear table.lines th, .lib-clear table.lines td { border: 1px solid #ccc; padding: 4px 6px; }\n\t.lib-clear table.lines th { background: #f3f3f3; text-align: left; }\n\t.lib-clear .num { text-align: right; }\n\t.lib-clear .sign { margin-top: 36px; width: 100%; }\n\t.lib-clear .sign td { width: 50%; padding-top: 28px; border-top: 1px solid #999; }\n</style>\n<div class=\"lib-clear\">\n\t<h3>{{ _(\"Library Clearance\") }}</h3>\n\t<table class=\"meta\">\n\t\t<tr><td>{{ _(\"Clearance\") }}</td><td><b>{{ doc.name }}</b></td><td>{{ _(\"Date\") }}</td><td>{{ frappe.utils.formatdate(doc.clearance_date) }}</td></tr>\n\t\t<tr><td>{{ _(\"Student\") }}</td><td><b>{{ doc.student_name }}</b> ({{ doc.student }})</td><td>{{ _(\"Class\") }}</td><td>{{ doc.student_batch or \"\" }}</td></tr>\n\t\t<tr><td>{{ _(\"Academic Year\") }}</td><td>{{ doc.academic_year or \"\" }}</td><td></td><td></td></tr>\n\t</table>\n\t{% if doc.status == \"Cleared\" %}\n\t<div class=\"verdict ok\">{{ _(\"CLEARED: nothing is outstanding with the library.\") }}</div>\n\t{% else %}\n\t<div class=\"verdict owe\">{{ _(\"NOT CLEARED\") }}</div>\n\t<table class=\"lines\">\n\t\t<tr><th>{{ _(\"Outstanding\") }}</th><th>{{ _(\"Document\") }}</th><th>{{ _(\"Detail\") }}</th><th class=\"num\">{{ _(\"Amount\") }}</th></tr>\n\t\t{% for row in doc.items %}\n\t\t<tr><td>{{ _(row.check_type) }}</td><td>{{ row.reference_name }}</td><td>{{ row.detail or \"\" }}</td>\n\t\t\t<td class=\"num\">{{ row.get_formatted(\"amount\", doc) if row.amount else \"\" }}</td></tr>\n\t\t{% endfor %}\n\t\t<tr><td colspan=\"3\" class=\"num\"><b>{{ _(\"Total owed\") }}</b></td><td class=\"num\"><b>{{ doc.get_formatted(\"total_owed\") }}</b></td></tr>\n\t</table>\n\t{% endif %}\n\t<table class=\"sign\"><tr><td>{{ _(\"Librarian\") }}</td><td>{{ _(\"Date and stamp\") }}</td></tr></table>\n</div>\n",
 "idx": 0,
